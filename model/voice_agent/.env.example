# Copy to .env; the live launcher loads it server-side. Never commit .env.
GEMINI_API_KEY=
LLM_MODEL=gemini-3.6-flash
DEEPGRAM_API_KEY=
STT_MODEL=nova-3
STT_LANGUAGE=multi
RIME_API_KEY=
RIME_MODEL=
RIME_VOICE=
RIME_LANGUAGE=
# Base URL only; the LiveKit plugin appends /ws3.
RIME_BASE_URL=wss://users-ws.rime.ai
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
DEMO_TOOL_DELAY=4

# Active synthesis path; avoids reuse of closing WebSocket connections.
RIME_HTTP_URL=https://users.rime.ai/v1/rime-tts

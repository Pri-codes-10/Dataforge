# SUTRA Frontend — Environment Variables
#
# Copy this file to .env and fill in values for your environment.
# NEVER commit .env to version control.
#
# ─────────────────────────────────────────────
# Backend API
# ─────────────────────────────────────────────
#
# The base URL for the SUTRA backend API.
# Leave empty to run in frontend-only mode (mock data).
# Example: https://api.sutra.yourdomain.com
#
VITE_API_URL=

# Sarvam AI API Key (required for Speech-to-Text and LLM agent)
SARVAM_API_KEY=

# Sarvam Endpoints & Model (optional overrides)
SARVAM_API_URL=https://api.sarvam.ai/v1/chat/completions
SARVAM_MODEL=sarvam-105b-conversations
SARVAM_STT_URL=https://api.sarvam.ai/speech-to-text

# Rime TTS API Key (required for voice synthesis)
RIME_API_KEY=
RIME_VOICE=aria

# Backend Server Configuration (optional)
APP_ENV=development
DEBUG=true
REDIS_URL=redis://localhost:6379
